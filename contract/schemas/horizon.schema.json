{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "horizon.schema.json",
  "title": "horizon/<site_id>.json (09_contrato_datos.md §5)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "site_id", "lat_deg", "lon_deg", "site_height_m", "relief", "relief_label",
               "dem_stack", "az_step_deg", "n_az", "law", "max_dist_m", "masks", "smooth_el_deg", "stats", "profile"],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "site_id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "lat_deg": { "type": "number", "minimum": -90, "maximum": 90 },
    "lon_deg": { "type": "number", "exclusiveMinimum": -180, "maximum": 180 },
    "site_height_m": { "type": "number" },
    "relief": { "enum": ["lola_polar", "lola_60s", "sldem2015", "smooth"] },
    "relief_label": {
      "enum": ["LOLA polar 40 m + 120 m", "LOLA polar 120 m", "LOLA 120 m", "SLDEM2015 59 m", "Smooth Moon (no terrain)"]
    },
    "dem_stack": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "az_step_deg": { "const": 0.5 },
    "n_az": { "const": 720 },
    "law": { "enum": ["full", "fast"] },
    "max_dist_m": { "type": "number", "minimum": 0 },
    "masks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/mask" }
    },
    "smooth_el_deg": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^(2|10)$": { "type": "number", "maximum": 0 } },
      "minProperties": 1
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["truncated_az", "min_truncation_dist_m", "nodata_samples", "empty_az", "grid_usage",
                   "min_el_deg", "max_el_deg", "warning"],
      "properties": {
        "truncated_az": { "type": "integer", "minimum": 0, "maximum": 720 },
        "min_truncation_dist_m": { "type": ["number", "null"], "minimum": 0 },
        "nodata_samples": { "type": "integer", "minimum": 0 },
        "empty_az": { "type": "integer", "minimum": 0, "maximum": 720 },
        "grid_usage": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "min_el_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "max_el_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "warning": { "type": ["string", "null"] }
      }
    },
    "profile": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "n_bins", "observer_height_m"],
          "properties": {
            "file": { "type": "string", "pattern": "^profile/[a-z0-9]+(-[a-z0-9]+)*\\.bin\\.gz$" },
            "n_bins": { "const": 512 },
            "observer_height_m": { "const": 2 }
          }
        },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "mask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observer_height_m", "el_deg", "dist_m", "blk_lat_deg", "blk_lon_deg", "blk_height_m"],
      "properties": {
        "observer_height_m": { "enum": [2, 10] },
        "el_deg": {
          "type": "array", "minItems": 720, "maxItems": 720,
          "items": { "type": "number", "minimum": -90, "maximum": 90 }
        },
        "dist_m": {
          "type": "array", "minItems": 720, "maxItems": 720,
          "items": { "type": "number", "minimum": 0 }
        },
        "blk_lat_deg": {
          "type": "array", "minItems": 720, "maxItems": 720,
          "items": { "type": "number", "minimum": -90, "maximum": 90 }
        },
        "blk_lon_deg": {
          "type": "array", "minItems": 720, "maxItems": 720,
          "items": { "type": "number", "exclusiveMinimum": -180, "maximum": 180 }
        },
        "blk_height_m": {
          "type": "array", "minItems": 720, "maxItems": 720,
          "items": { "type": "number" }
        }
      }
    }
  }
}
