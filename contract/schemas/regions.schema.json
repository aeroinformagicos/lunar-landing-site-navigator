{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regions.schema.json",
  "title": "map/regions.json (09_contrato_datos.md §8.2, 04_catalogo_sitios.md §3)",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "regions"],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "regions": {
      "type": "array",
      "minItems": 9,
      "maxItems": 13,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "lat_deg", "lon_deg", "x_m", "y_m", "size_km", "box_m", "site_id", "status", "source"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 1 },
          "lat_deg": { "type": "number", "minimum": -90, "maximum": 90 },
          "lon_deg": { "type": "number", "exclusiveMinimum": -180, "maximum": 180 },
          "x_m": { "type": "number" },
          "y_m": { "type": "number" },
          "size_km": { "type": "number", "exclusiveMinimum": 0 },
          "box_m": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } },
          "site_id": { "type": ["string", "null"], "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "status": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": { "label": { "type": "string" }, "url": { "type": "string" } }
          }
        }
      }
    }
  }
}
